import os

from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription
from launch.launch_description_sources import PythonLaunchDescriptionSource, FrontendLaunchDescriptionSource
from launch.conditions import IfCondition
from launch_ros.actions import Node
from launch.substitutions import LaunchConfiguration

# Planning/inference side (runs on this machine, off-robot): terrain analysis,
# local_planner, far_planner (route planner), visualization, joystick, RViz,
# and G1 motion control over unitree_sdk2 (DDS) -- no AES key needed, unlike
# the legacy WebRTC backend. Perception (/state_estimation + /registered_scan)
# is forwarded in from the Jetson on G1 by domain_bridge_g1.yaml;
# pathFollower's /cmd_vel is consumed locally by g1_sdk_bridge, which talks
# to the robot directly over its 192.168.123.x network via network_interface
# -- it does NOT cross the domain_bridge back to Jetson.
#
# g1_sdk_bridge starts DISABLED (safety gate): the robot won't stand or move
# until 'stand_up' then 'enable true' are called on its services (see
# docker/README.md section 5).
#
# No lidar driver, no SLAM here -- those stay on the robot side
# (system_g1_perception.launch).

def generate_launch_description():
  route_planner_config = LaunchConfiguration('route_planner_config')
  world_name = LaunchConfiguration('world_name')
  sensorOffsetX = LaunchConfiguration('sensorOffsetX')
  sensorOffsetY = LaunchConfiguration('sensorOffsetY')
  cameraOffsetZ = LaunchConfiguration('cameraOffsetZ')
  vehicleX = LaunchConfiguration('vehicleX')
  vehicleY = LaunchConfiguration('vehicleY')
  checkTerrainConn = LaunchConfiguration('checkTerrainConn')
  use_far_planner = LaunchConfiguration('use_far_planner')
  network_interface = LaunchConfiguration('network_interface')
  autonomyMode = LaunchConfiguration('autonomyMode')
  start_path_follower = LaunchConfiguration('start_path_follower')
  start_sdk_bridge = LaunchConfiguration('start_sdk_bridge')

  declare_route_planner_config = DeclareLaunchArgument('route_planner_config', default_value='indoor', description='')
  declare_world_name = DeclareLaunchArgument('world_name', default_value='real_world', description='')
  declare_sensorOffsetX = DeclareLaunchArgument('sensorOffsetX', default_value='0.05', description='')
  declare_sensorOffsetY = DeclareLaunchArgument('sensorOffsetY', default_value='0.0', description='')
  declare_cameraOffsetZ = DeclareLaunchArgument('cameraOffsetZ', default_value='0.25', description='')
  declare_vehicleX = DeclareLaunchArgument('vehicleX', default_value='0.0', description='')
  declare_vehicleY = DeclareLaunchArgument('vehicleY', default_value='0.0', description='')
  declare_checkTerrainConn = DeclareLaunchArgument('checkTerrainConn', default_value='true', description='')
  declare_use_far_planner = DeclareLaunchArgument(
    'use_far_planner', default_value='true',
    description='Start far_planner (route planner). Set false to use only local_planner waypoint/smart-joystick modes.'
  )
  declare_network_interface = DeclareLaunchArgument(
    'network_interface', default_value='eth0',
    description='NIC on the 192.168.123.x robot net that unitree_sdk2 talks DDS over '
                '(this machine: pass the IP 192.168.123.165 -- enp4s0 has two addresses and binding by name picks 10.1.1.101).'
  )
  # G1 VLFM (system_planner_g1_vlfm.sh): autonomyMode:=true so localPlanner
  # steers toward /way_point, start_path_follower:=false because
  # run_vlfm_pipeline_g1.py starts pathFollower itself after its initial scan.
  declare_autonomyMode = DeclareLaunchArgument('autonomyMode', default_value='false', description='')
  declare_start_path_follower = DeclareLaunchArgument('start_path_follower', default_value='true', description='')
  # false: g1_sdk_bridge runs in its own container (g1_bridge) and must NOT be
  # restarted with the planner -- the SDK driver Damp()s the robot on exit.
  declare_start_sdk_bridge = DeclareLaunchArgument('start_sdk_bridge', default_value='true', description='')

  start_local_planner = IncludeLaunchDescription(
    PythonLaunchDescriptionSource(os.path.join(
      get_package_share_directory('local_planner'), 'launch', 'local_planner.launch.py')
    ),
    launch_arguments={
      'realRobot': 'true',
      'sensorOffsetX': sensorOffsetX,
      'sensorOffsetY': sensorOffsetY,
      'cameraOffsetZ': cameraOffsetZ,
      'goalX': vehicleX,
      'goalY': vehicleY,
      'autonomyMode': autonomyMode,
      'start_path_follower': start_path_follower,
    }.items()
  )

  start_terrain_analysis = IncludeLaunchDescription(
    PythonLaunchDescriptionSource(os.path.join(
        get_package_share_directory('terrain_analysis'), 'launch', 'terrain_analysis.launch.py')
    )
  )

  start_terrain_analysis_ext = IncludeLaunchDescription(
    FrontendLaunchDescriptionSource(os.path.join(
      get_package_share_directory('terrain_analysis_ext'), 'launch', 'terrain_analysis_ext.launch')
    ),
    launch_arguments={
      'checkTerrainConn': checkTerrainConn,
    }.items()
  )

  start_sensor_scan_generation = IncludeLaunchDescription(
    FrontendLaunchDescriptionSource(os.path.join(
      get_package_share_directory('sensor_scan_generation'), 'launch', 'sensor_scan_generation.launch')
    )
  )

  start_visualization_tools = IncludeLaunchDescription(
    FrontendLaunchDescriptionSource(os.path.join(
      get_package_share_directory('visualization_tools'), 'launch', 'visualization_tools.launch')
    ),
    launch_arguments={
      'world_name': world_name,
    }.items()
  )

  start_joy = Node(
    package='joy',
    executable='joy_node',
    name='ps3_joy',
    output='screen',
    parameters=[{
      'dev': "/dev/input/js0",
      'deadzone': 0.12,
      'autorepeat_rate': 0.0,
    }]
  )

  start_far_planner = IncludeLaunchDescription(
    PythonLaunchDescriptionSource(
      [get_package_share_directory('far_planner'), '/launch/far_planner.launch']),
    condition=IfCondition(use_far_planner),
    launch_arguments={
      'config': route_planner_config,
    }.items()
  )

  start_g1_sdk = IncludeLaunchDescription(
    PythonLaunchDescriptionSource(os.path.join(
      get_package_share_directory('unitree_g1_sdk_bridge'),
      'launch',
      'g1_sdk_control.launch.py')
    ),
    condition=IfCondition(start_sdk_bridge),
    launch_arguments={
      'network_interface': network_interface,
      'enable_on_start': 'false',
    }.items()
  )

  ld = LaunchDescription()
  ld.add_action(declare_route_planner_config)
  ld.add_action(declare_world_name)
  ld.add_action(declare_sensorOffsetX)
  ld.add_action(declare_sensorOffsetY)
  ld.add_action(declare_cameraOffsetZ)
  ld.add_action(declare_vehicleX)
  ld.add_action(declare_vehicleY)
  ld.add_action(declare_checkTerrainConn)
  ld.add_action(declare_use_far_planner)
  ld.add_action(declare_network_interface)
  ld.add_action(declare_autonomyMode)
  ld.add_action(declare_start_path_follower)
  ld.add_action(declare_start_sdk_bridge)

  ld.add_action(start_local_planner)
  ld.add_action(start_terrain_analysis)
  ld.add_action(start_terrain_analysis_ext)
  ld.add_action(start_sensor_scan_generation)
  ld.add_action(start_visualization_tools)
  ld.add_action(start_joy)
  ld.add_action(start_far_planner)
  ld.add_action(start_g1_sdk)

  return ld
