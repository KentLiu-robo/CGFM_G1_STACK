# G1 head D435i extrinsic, calibrated 2026-10-02 16:20 with calibrate_camera_floor.py
# (robot standing in FSM 501 on flat concrete -- lidar-only floor fit confirmed the floor
#  is flat in the map frame (tilt 0.28 deg); final 12-frame fit: slope_fwd -0.0009,
#  slope_left -0.0022, floor_z -1.339).
# Load before run_vlfm_pipeline_g1.py:   source ~/Taowen/G1_STACK/src/vlfm_bridge/g1_camera_calib.env
#
# Valid only for Jetson SLAM run with ROBOT_CONFIG_PATH=unitree/unitree_g1 (jetson_run_perception.sh).
# The 15:00 calibration (pitch 47.4, roll 0, floor -1.28) was made while SLAM was on the default
# mechanum_drive config and no longer matched once SLAM was switched to unitree_g1.
#
# G1_FLOOR_Z is the floor height in the SLAM map frame (origin = lidar pose at SLAM start),
# so it is only valid when Jetson SLAM was started with the robot STANDING.
# SLAM started while hanging/squatting -> re-run calibrate_camera_floor.py.
# TX/TY/TZ were not calibrated (floor fit cannot separate them from FLOOR_Z); placeholders.
# Because of that the camera floor (-1.34) sits ~15 cm below the lidar floor (-1.19);
# heights in vlfm's maps are camera-consistent, so this does not affect obstacle marking.
export G1_VLFM_POSE_MODE=full
export G1_CAM_PITCH_DOWN_DEG=50.0
export G1_CAM_ROLL_DEG=2.4
export G1_CAM_YAW_DEG=0.0
export G1_CAM_TX=0.05
export G1_CAM_TY=0.0
export G1_CAM_TZ=-0.10
export G1_FLOOR_Z=-1.34
export G1_CAM_CALIBRATED=1
