# Copy to configs/paths.env and adjust. The shell tools in tools/ read it automatically (tools/env.sh).
# For the Python scripts export the same variables first:   set -a; . configs/paths.env; set +a

# --- network ---------------------------------------------------------------------------------
GO2_JETSON_IP=192.168.3.18          # on-board computer running the Livox driver + RealSense stream server
GO2_JETSON_USER=unitree

# --- base navigation stack (SLAM, terrain, localPlanner, pathFollower, unitree WebRTC control) ---
GO2_WS_SETUP=$HOME/GO2_STACK_dev_ws/install/setup.bash       # install/setup.bash of its ROS 2 workspace
# GO2_LOCAL_PLANNER_YAML=...                                 # default: <workspace install>/local_planner/share/.../unitree_go2_slow.yaml
GO2_ROS_ENV_SCRIPT=                                          # optional: script that sets ROS_DOMAIN_ID / CycloneDDS config
GO2_WEBRTC_WS_SETUP=$HOME/unitree_webrtc_ws/install/setup.bash
GO2_WEBRTC_VENV=$HOME/unitree_venv/bin/activate

# --- Python / models ---------------------------------------------------------------------------
VLFM_REPO=$HOME/vlfm                # checkout of github.com/bdaiinstitute/vlfm (YOLO-World server + vlfm package)
VLFM_PYTHON=python                  # interpreter of the env where vlfm, torch, open_clip are installed
CGFM_VLM_PYTHON=python              # interpreter with vLLM 0.7.2 + transformers 4.49.0 (Qwen2.5-VL server)
CGFM_DETECTORS=yolo_world           # or "all" to also start/require the other four VLFM servers
CGFM_RES_DIR=./results/life_long    # where the pipelines write run directories (default: ./results/<mode>)

# GO2_RELAY_UNIT=go2-relay          # Jetson systemd unit bridging the Go2 network to WiFi (pre-flight check); "none" skips it
